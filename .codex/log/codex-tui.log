*** Add File: bot/config.py
+from dataclasses import dataclass
+import os
+
+from dotenv import load_dotenv
+
+
+@dataclass(frozen=True)
+class Settings:
+    discord_bot_token: str
+    discord_guild_id: int | None
+    skolaonline_base_url: str
+    skolaonline_username: str
+    skolaonline_password: str
+    request_timeout_seconds: int
+    log_level: str
+
+
+def _optional_int(value: str | None) -> int | None:
+    if not value:
+        return None
+    return int(value)
+
+
+def load_settings() -> Settings:
+    load_dotenv()
+
+    token = os.getenv("DISCORD_BOT_TOKEN", "").strip()
+    if not token or token == "paste-your-discord-bot-token-here":
+        raise RuntimeError("Set DISCORD_BOT_TOKEN in .env before starting the bot.")
+
+    return Settings(
+        discord_bot_token=token,
+        discord_guild_id=_optional_int(os.getenv("DISCORD_GUILD_ID")),
+        skolaonline_base_url=os.getenv("SKOLAONLINE_BASE_URL", "https://www.skolaonline.cz").rstrip("/"),
+        skolaonline_username=os.getenv("SKOLAONLINE_USERNAME", "").strip(),
+        skolaonline_password=os.getenv("SKOLAONLINE_PASSWORD", "").strip(),
+        request_timeout_seconds=int(os.getenv("REQUEST_TIMEOUT_SECONDS", "20")),
+        log_level=os.getenv("LOG_LEVEL", "INFO").upper(),
+    )
*** Add File: bot/discord_bot.py
+import logging
+
+import discord
+from discord import app_commands
+
+from bot.config import Settings, load_settings
+from bot.skolaonline.client import SkolaOnlineClient
+from bot.skolaonline.parser import parse_latest_items
+
+
+class SkolaBot(discord.Client):
+    def __init__(self, settings: Settings) -> None:
+        intents = discord.Intents.default()
+        super().__init__(intents=intents)
+        self.settings = settings
+        self.tree = app_commands.CommandTree(self)
+        self.skolaonline = SkolaOnlineClient(
+            base_url=settings.skolaonline_base_url,
+            username=settings.skolaonline_username,
+            password=settings.skolaonline_password,
+            timeout=settings.request_timeout_seconds,
+        )
+
+    async def setup_hook(self) -> None:
+        register_commands(self)
+
+        if self.settings.discord_guild_id:
+            guild = discord.Object(id=self.settings.discord_guild_id)
+            self.tree.copy_global_to(guild=guild)
+            await self.tree.sync(guild=guild)
+            logging.info("Synced slash commands to guild %s", self.settings.discord_guild_id)
+        else:
+            await self.tree.sync()
+            logging.info("Synced global slash commands")
+
+    async def on_ready(self) -> None:
+        logging.info("Logged in as %s (%s)", self.user, self.user.id if self.user else "unknown")
+
+    async def close(self) -> None:
+        self.skolaonline.close()
+        await super().close()
+
+
+def register_commands(client: SkolaBot) -> None:
+    @client.tree.command(name="ping", description="Check whether the bot is online.")
+    async def ping(interaction: discord.Interaction) -> None:
+        await interaction.response.send_message("Pong", ephemeral=True)
+
+    @client.tree.command(name="skola_status", description="Check whether SkolaOnline is reachable.")
+    async def skola_status(interaction: discord.Interaction) -> None:
+        await interaction.response.defer(ephemeral=True)
+        try:
+            reachable = client.skolaonline.check_reachable()
+        except Exception as exc:
+            logging.exception("SkolaOnline reachability check failed")
+            await interaction.followup.send(f"SkolaOnline check failed: `{exc}`", ephemeral=True)
+            return
+
+        message = "SkolaOnline is reachable." if reachable else "SkolaOnline returned an unexpected response."
+        await interaction.followup.send(message, ephemeral=True)
+
+    @client.tree.command(name="skola_latest", description="Fetch and parse the latest SkolaOnline items.")
+    async def skola_latest(interaction: discord.Interaction) -> None:
+        await interaction.response.defer(ephemeral=True)
+        try:
+            html = client.skolaonline.fetch_latest_page()
+            items = parse_latest_items(html)
+        except NotImplementedError as exc:
+            await interaction.followup.send(str(exc), ephemeral=True)
+            return
+        except Exception as exc:
+            logging.exception("Failed to fetch latest SkolaOnline items")
+            await interaction.followup.send(f"Failed to fetch SkolaOnline data: `{exc}`", ephemeral=True)
+            return
+
+        if not items:
+            await interaction.followup.send("No items found. Update the parser selectors for your page.", ephemeral=True)
+            return
+
+        lines = [f"- **{item.title}**: {item.value}" for item in items[:10]]
+        await interaction.followup.send("\n".join(lines), ephemeral=True)
+
+
+def main() -> None:
+    settings = load_settings()
+    logging.basicConfig(
+        level=settings.log_level,
+        format="%(asctime)s %(levelname)s %(name)s: %(message)s",
+    )
+
+    bot = SkolaBot(settings)
+    bot.run(settings.discord_bot_token)
