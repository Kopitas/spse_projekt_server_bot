+import requests
+
+
+class SkolaOnlineClient:
+    def __init__(self, base_url: str, username: str, password: str, timeout: int = 20) -> None:
+        self.base_url = base_url.rstrip("/")
+        self.username = username
+        self.password = password
+        self.timeout = timeout
+        self.session = requests.Session()
+        self.session.headers.update(
+            {
+                "User-Agent": "Mozilla/5.0 (compatible; SkolaOnlineDiscordBot/0.1)",
+            }
+        )
+
+    def close(self) -> None:
+        self.session.close()
+
+    def check_reachable(self) -> bool:
+        response = self.session.get(self.base_url, timeout=self.timeout)
+        return response.ok
+
+    def login(self) -> None:
+        if not self.username or not self.password:
+            raise RuntimeError("Set SKOLAONLINE_USERNAME and SKOLAONLINE_PASSWORD in .env.")
+
+        raise NotImplementedError(
+            "Add the real SkolaOnline login flow in bot/skolaonline/client.py. "
+            "Inspect the login form fields and submit them with this session."
+        )
+
+    def fetch_latest_page(self) -> str:
+        self.login()
+
+        # Replace this path with the SkolaOnline page that contains the information you need.
+        latest_url = f"{self.base_url}/"
+        response = self.session.get(latest_url, timeout=self.timeout)
+        response.raise_for_status()
+        return response.text
*** Add File: bot/skolaonline/parser.py
+from dataclasses import dataclass
+
+from bs4 import BeautifulSoup
+
+
+@dataclass(frozen=True)
+class ParsedItem:
+    title: str
+    value: str
+
+
+def parse_latest_items(html: str) -> list[ParsedItem]:
+    soup = BeautifulSoup(html, "html.parser")
+
+    # Replace this selector with the real elements from the SkolaOnline page you want to parse.
+    rows = soup.select(".latest-item")
+
+    items: list[ParsedItem] = []
+    for row in rows:
+        title = row.select_one(".title")
+        value = row.select_one(".value")
+
+        if not title or not value:
+            continue
+
+        items.append(
+            ParsedItem(
+                title=title.get_text(" ", strip=True),
+                value=value.get_text(" ", strip=True),
+            )
+        )
+
+    return items
